{
  "$schema": "https://json.schemastore.org/package",
  "name": "template-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "tsx packages/cli/src/index.ts package",
    "template": "tsx packages/cli/src/index.ts repo",
    "test": "pnpm -r run test && pnpm run test:release && pnpm run test:ai-review && pnpm run test:homes && pnpm run test:stamp && pnpm run test:workflows && pnpm run test:actions",
    "test:release": "node --test \"scripts/release/*.test.ts\"",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.ts\"",
    "test:homes": "node --test \"scripts/homes/*.test.ts\"",
    "homes:exports": "node scripts/homes/exports.ts",
    "homes:npm-drift": "node scripts/homes/npm-drift.ts --check",
    "test:stamp": "node --test \"scripts/stamp/*.test.ts\"",
    "test:workflows": "node --test \"scripts/workflows/*.test.ts\"",
    "test:actions": "node --test \".github/actions/*.test.ts\"",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "workspace:*",
    "@mark1russell7/boundaries": "workspace:*",
    "@mark1russell7/conventions": "workspace:*",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/service": "^0.9.3",
    "@mark1russell7/ste-lint": "^0.3.0",
    "@mark1russell7/text": "^0.0.15",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "job-fails": {
        "advisory": [
          "reusable-ci.yml#coverage until 2027-02-16: A caller with no strict coverage gets coverage on main as advice. The job checks runs the same tests strictly, and a called workflow has no other way to keep a job out of the result of its caller. On 2027-02-16 ci reads the callers again: the mode ends when no caller reads its advice."
        ],
        "reason": "The non-strict coverage of reusable-ci.yml is advice, not a gate. Each entry has its own reason and its last day."
      }
    }
  }
}
