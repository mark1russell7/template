{
  "$schema": "https://json.schemastore.org/package",
  "name": "template-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "tsx packages/cli/src/index.ts package",
    "template": "tsx packages/cli/src/index.ts repo",
    "test": "pnpm -r run test && pnpm run test:release && pnpm run test:ai-review && pnpm run test:workflows",
    "test:release": "node --test \"scripts/release/*.test.ts\"",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.ts\"",
    "test:workflows": "node --test \"scripts/workflows/*.test.ts\"",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "workspace:*",
    "@mark1russell7/boundaries": "workspace:*",
    "@mark1russell7/conventions": "workspace:*",
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/ste-lint": "^0.1.1",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
