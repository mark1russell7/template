{
  "$schema": "https://json.schemastore.org/package",
  "name": "template-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "tsx packages/cli/src/index.ts package",
    "template": "tsx packages/cli/src/index.ts repo",
    "test": "pnpm -r run test && pnpm run test:release && pnpm run test:ai-review && pnpm run test:workflows",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "test:ai-review": "node --test \"scripts/ai-review/*.test.mjs\"",
    "test:workflows": "node --test \"scripts/workflows/*.test.mjs\"",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.mjs packages"
  },
  "devDependencies": {
    "@mark1russell7/boundaries": "workspace:*",
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint",
    "@swc/core": "^1.15.0",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
