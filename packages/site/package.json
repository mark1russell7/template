{
  "$schema": "https://json.schemastore.org/package",
  "name": "@template/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of the template: a preview of the files of each preset of the CLI, and an explorer of the shared workflows.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/site-pages": "workspace:*",
    "@mark1russell7/template-cli": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
