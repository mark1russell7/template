{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/template-cli",
  "version": "0.1.13",
  "description": "The CLI of the template monorepos: it adds a source package with a preset of @mark1russell7/cue, a server on @mark1russell7/service too, and it renames a new repository.",
  "keywords": [
    "monorepo",
    "pnpm",
    "template",
    "scaffold",
    "cli",
    "typescript",
    "cue"
  ],
  "homepage": "https://github.com/mark1russell7/template/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/template.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "bin": {
    "template": "./src/index.ts"
  },
  "files": [
    "build",
    "src/presets"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "template": "./build/index.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@grafana/faro-web-sdk": "^2.13.0",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/otel-ts": "^0.11.2",
    "@mark1russell7/service": "^0.13.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-web": "^0.70.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-long-task": "^0.69.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "async-browser-context": "^0.3.0",
    "page-lifecycle-tracker": "^0.1.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
