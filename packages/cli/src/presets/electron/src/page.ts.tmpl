/**
 * This file is the script of the first page of {{package}}. `tsdown` builds it to `build/page/page.js`. It waits for
 * the message port of the main process, sends `ping`, and shows the answer. Replace it with the interface of the app.
 */
/// <reference lib="dom" />

const status = document.getElementById("status");

window.addEventListener("message", (event: MessageEvent<unknown>) => {
  const data = event.data as { type?: unknown } | null;
  if (event.source !== window || event.origin !== window.location.origin || data?.type !== "port") return;
  const [port] = event.ports;
  if (port === undefined) return;
  port.onmessage = (message: MessageEvent<unknown>) => {
    if ((message.data as { type?: unknown } | null)?.type === "pong" && status) status.textContent = "The main process answered.";
  };
  port.postMessage({ type: "ping" });
});
