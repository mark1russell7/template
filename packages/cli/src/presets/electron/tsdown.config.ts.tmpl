import { type UserConfig, defineConfig } from "tsdown";

// Three builds for the three processes of the app. Electron is in the app, so no build bundles it.
// - The main process: an ES module for Node.js.
// - The preload script: CommonJS, because a preload script in a sandbox cannot be an ES module.
// - The page: an ES module for the browser, with the files of page/ next to it.
const shared: UserConfig = { platform: "node", fixedExtension: false, sourcemap: true, dts: false, deps: { neverBundle: ["electron"] } };

export default defineConfig([
  { ...shared, entry: { main: "src/main.ts" }, format: "esm", outDir: "build/main" },
  { ...shared, entry: { preload: "src/preload.ts" }, format: "cjs", outDir: "build/preload" },
  { ...shared, entry: { page: "src/page.ts" }, format: "esm", platform: "browser", outDir: "build/page", copy: ["page/index.html", "page/page.css"] },
]);
