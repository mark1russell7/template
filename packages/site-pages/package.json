{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/site-pages",
  "version": "0.3.4",
  "description": "A release timeline page and a live status page for the site of a GitHub repository: JSON data and standalone HTML, made at deploy time.",
  "keywords": [
    "github-pages",
    "releases",
    "changelog",
    "changesets",
    "status",
    "roadmap",
    "static-site",
    "cli"
  ],
  "homepage": "https://github.com/mark1russell7/template/tree/main/packages/site-pages#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/template.git",
    "directory": "packages/site-pages"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chrome": "./src/chrome.ts",
    "./explorer": "./src/explorer/index.ts",
    "./vite": "./src/vite.ts",
    "./scroll-cue.css": "./styles/scroll-cue.css",
    "./shell.css": "./styles/shell.css",
    "./explorer.css": "./styles/explorer.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "site-pages": "./src/cli.ts"
  },
  "files": [
    "build",
    "styles"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./chrome": {
        "types": "./build/chrome.d.ts",
        "import": "./build/chrome.js"
      },
      "./explorer": {
        "types": "./build/explorer/index.d.ts",
        "import": "./build/explorer/index.js"
      },
      "./vite": {
        "types": "./build/vite.d.ts",
        "import": "./build/vite.js"
      },
      "./scroll-cue.css": "./styles/scroll-cue.css",
      "./shell.css": "./styles/shell.css",
      "./explorer.css": "./styles/explorer.css",
      "./package.json": "./package.json"
    },
    "bin": {
      "site-pages": "./build/cli.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rigor-statistics": "^0.1.9"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
