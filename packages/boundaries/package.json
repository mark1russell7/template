{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/boundaries",
  "version": "0.2.0",
  "description": "The import boundaries of a pnpm workspace as a dependency-cruiser configuration: each package is imported only through the entries of its package.json.",
  "keywords": [
    "dependency-cruiser",
    "monorepo",
    "pnpm",
    "workspace",
    "architecture",
    "boundaries",
    "exports",
    "lint"
  ],
  "homepage": "https://github.com/mark1russell7/template/tree/main/packages/boundaries#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/template.git",
    "directory": "packages/boundaries"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./build/index.d.ts",
          "default": "./build/index.js"
        },
        "require": {
          "types": "./build/index.d.cts",
          "default": "./build/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "dependency-cruiser": "^17.0.0 || ^18.0.0",
    "@swc/core": "^1.10.0"
  },
  "peerDependenciesMeta": {
    "dependency-cruiser": {
      "optional": true
    },
    "@swc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "dependency-cruiser": "^18.7.0",
    "tsdown": "^0.23.1",
    "@swc/core": "^1.15.0"
  }
}
